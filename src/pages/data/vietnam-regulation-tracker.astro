---
import BaseLayout from '@layouts/BaseLayout.astro';
import CiteThis from '@components/CiteThis.astro';
import {
  REGULATIONS,
  TRACKER_UPDATED,
  STATUS_LABEL,
} from '../../data/regulation-tracker';

const title = "Vietnam Regulation Tracker for Foreign Sellers — Laws & Decrees";
const description = "A maintained, dated tracker of the Vietnam laws and decrees that change the cost or legality of selling into Vietnam — de-minimis, platform tax withholding, the 2025 E-Commerce Law, and data-protection rules. Each entry cites the official instrument.";
const canonical = "https://vnmarketinsights.com/data/vietnam-regulation-tracker/";

// Newest effective date first.
const entries = [...REGULATIONS].sort((a, b) => b.effectiveDate.localeCompare(a.effectiveDate));

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Vietnam Regulation Tracker for Foreign Sellers",
  "description": "A maintained reference of Vietnam laws and decrees affecting foreign operators selling into Vietnam — with official instrument numbers, effective dates, plain-English impact, and primary sources.",
  "url": canonical,
  "temporalCoverage": "2025/..",
  "dateModified": TRACKER_UPDATED,
  "isAccessibleForFree": true,
  "creator": {
    "@type": "Organization",
    "name": "VN Market Insights",
    "url": "https://vnmarketinsights.com/",
  },
  "license": "https://vnmarketinsights.com/sources/",
  "keywords": ["Vietnam regulation", "e-commerce law", "import duty", "de minimis", "Decree 117", "Personal Data Protection Law", "cross-border commerce", "market entry"],
  "variableMeasured": ["Instrument number", "Effective date", "Regulatory status", "Operator impact"],
};

const statusOrder = ['in-effect', 'upcoming', 'pending-guidance'];
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonical}
  pageType="Article"
  articleSection="Data"
  publishedDate="2026-08-02"
  lastUpdated={TRACKER_UPDATED}
  structuredData={datasetSchema}
  mainClass="container"
>
  <article class="data-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/data/">Data</a>
      <span aria-hidden="true">/</span>
      <span>Regulation Tracker</span>
    </nav>

    <header class="data-header">
      <h1>{title}</h1>
      <p class="data-lead">
        Vietnam's rules for foreign sellers are changing fast — the de-minimis exemption is gone,
        platforms now withhold your tax, and both a new E-Commerce Law and a Personal Data Protection
        Law took effect. This is a <strong>maintained</strong> tracker: every entry names the official
        instrument, its effective date, what changed, and what it means for you. Not legal advice —
        verify against the primary source and your advisor before acting.
      </p>
      <p class="data-meta">Last reviewed {TRACKER_UPDATED} · {entries.length} instruments tracked · Sorted by effective date (newest first)</p>
    </header>

    <ol class="reg-list">
      {entries.map(r => (
        <li class="reg-card" id={r.id}>
          <div class="reg-card__top">
            <span class:list={["reg-badge", `reg-badge--${r.status}`]}>{STATUS_LABEL[r.status]}</span>
            <span class="reg-cat">{r.category}</span>
            <span class="reg-eff">Effective {r.effectiveDisplay}</span>
          </div>
          <h2 class="reg-title">{r.title}</h2>
          <p class="reg-instrument">{r.instrument}{r.signedDate ? ` · signed ${r.signedDate}` : ''}</p>
          <p class="reg-what"><strong>What changed:</strong> {r.whatChanged}</p>
          <p class="reg-impact"><strong>What it means for you:</strong> {r.impact}</p>
          <p class="reg-sources">
            <span class="reg-sources__label">Sources:</span>
            {r.sources.map((s, i) => (
              <>{i > 0 ? ' · ' : ''}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a></>
            ))}
            <span class="reg-verified">Verified {r.lastVerified}</span>
          </p>
        </li>
      ))}
    </ol>

    <section class="reg-methodology">
      <h2>How this tracker works</h2>
      <p>
        We track the laws and decrees that measurably change the cost or legality of selling into
        Vietnam as a foreign operator — not every regulatory footnote. Each entry links the official
        instrument (National Assembly gazette, Ministry of Finance database, or the issuing decree)
        plus a reputable secondary source, and carries a <em>last-verified</em> date. Statuses are:
        <strong>In effect</strong> (currently binding), <strong>Upcoming</strong> (dated future start),
        and <strong>Guidance pending</strong> (passed, but key details await an implementing decree).
      </p>
      <p>
        This is a reference compilation, not legal advice. Thresholds and penalties in newer laws may
        shift when guiding decrees are issued — always confirm the current text with a Vietnamese legal
        or customs advisor before you rely on a specific figure.
      </p>
    </section>

    <CiteThis title="Vietnam Regulation Tracker for Foreign Sellers" url={canonical} updated={TRACKER_UPDATED} />

    <section>
      <h2>Put these rules into numbers</h2>
      <ul class="related-list">
        <li><a href="/tools/landed-cost-calculator/">Landed-cost calculator</a> — models the removed de-minimis exemption (duty + 10% VAT)</li>
        <li><a href="/tools/channel-selector/">Channel selector</a> — includes the Decree 117 platform tax withholding</li>
        <li><a href="/sell-into-vietnam/">Sell into Vietnam</a> — the full cross-border playbook · <a href="/accept-payments-in-vietnam/">Accept payments in Vietnam</a></li>
        <li><a href="/data/">All datasets &amp; benchmarks</a> · <a href="/sources/">Data sources &amp; methodology</a></li>
      </ul>
    </section>

    <p class="data-footer">
      <a href="/data/">← All datasets</a> · <a href="/sources/">Data sources</a>
    </p>
  </article>
</BaseLayout>

<style>
  .data-page { max-width: var(--reading-width); }
  .breadcrumb { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-6); }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); text-decoration: underline; }
  .data-header { margin-bottom: var(--space-8); }
  .data-header h1 { border: none; margin-bottom: var(--space-3); }
  .data-lead { font-size: var(--text-lg); line-height: 1.6; color: var(--color-text); }
  .data-lead a { color: var(--color-accent); }
  .data-meta { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }

  .reg-list { list-style: none; padding: 0; margin: 0 0 var(--space-10); display: flex; flex-direction: column; gap: var(--space-5); }
  .reg-card { border: 1px solid var(--color-border-light); border-left: 3px solid var(--color-accent); border-radius: 2px; padding: var(--space-5) var(--space-6); background: var(--color-bg-subtle); scroll-margin-top: var(--space-8); }
  .reg-card__top { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-bottom: var(--space-3); font-size: var(--text-xs); }
  .reg-badge { font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 8px; border-radius: 100px; border: 1px solid transparent; }
  .reg-badge--in-effect { background: color-mix(in srgb, #16a34a 16%, transparent); color: #15803d; border-color: color-mix(in srgb, #16a34a 35%, transparent); }
  .reg-badge--upcoming { background: color-mix(in srgb, #d97706 16%, transparent); color: #b45309; border-color: color-mix(in srgb, #d97706 35%, transparent); }
  .reg-badge--pending-guidance { background: color-mix(in srgb, var(--color-text-muted) 14%, transparent); color: var(--color-text-muted); border-color: color-mix(in srgb, var(--color-text-muted) 30%, transparent); }
  .reg-cat { color: var(--color-text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
  .reg-eff { margin-left: auto; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .reg-title { font-size: var(--text-xl); line-height: 1.3; margin: 0 0 var(--space-1); border: none; }
  .reg-instrument { margin: 0 0 var(--space-3); font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .reg-what, .reg-impact { margin: 0 0 var(--space-3); line-height: 1.6; }
  .reg-sources { margin: var(--space-3) 0 0; padding-top: var(--space-3); border-top: 1px solid var(--color-border-light); font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.6; }
  .reg-sources__label { font-weight: 600; margin-right: var(--space-1); }
  .reg-sources a { color: var(--color-accent); }
  .reg-verified { display: inline-block; margin-left: var(--space-2); font-style: italic; }

  .reg-methodology { margin-bottom: var(--space-10); }
  section { margin-bottom: var(--space-10); }
  .data-page section p a, .reg-methodology p a { color: var(--color-accent); }
  .related-list { list-style: none; padding: 0; margin: var(--space-4) 0; }
  .related-list li { margin-bottom: var(--space-2); line-height: 1.55; }
  .related-list a { color: var(--color-accent); text-decoration: none; }
  .related-list a:hover { text-decoration: underline; }
  .data-footer { margin-top: var(--space-10); font-size: var(--text-sm); color: var(--color-text-muted); }
  .data-footer a { color: var(--color-text-muted); }
  .data-footer a:hover { color: var(--color-accent); }

  @media (prefers-color-scheme: dark) {
    .reg-badge--in-effect { color: #4ade80; }
    .reg-badge--upcoming { color: #fbbf24; }
  }
  :root[data-theme="dark"] .reg-badge--in-effect { color: #4ade80; }
  :root[data-theme="dark"] .reg-badge--upcoming { color: #fbbf24; }
</style>
