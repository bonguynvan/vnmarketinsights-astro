---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "How to Sell on TikTok Shop in Vietnam (2026) — Fees, Livestream & Setup";
const description = "A deep, sourced guide to selling on TikTok Shop Vietnam in 2026: the 2026 fee hikes (transaction 6%, category commission up to 19.8%), livestream and affiliate economics, whether foreigners can sell, product registration, and a worked net-payout example.";
const canonical = "https://vnmarketinsights.com/guides/how-to-sell-on-tiktok-shop-vietnam/";
const updated = "2026-08-12";

const steps = [
  {
    name: 'Confirm you can register — this is stricter than Shopee cross-border',
    text: 'TikTok Shop Vietnam requires a Vietnamese business registration — either a household business (hộ kinh doanh) or a registered company — plus a Vietnamese bank account, phone number, and KYC. Some individual-seller documents are accepted, but there is no easy ship-from-abroad cross-border account like Shopee\'s. Foreign brands almost always operate through a Vietnamese entity, a local partner, or an agency that runs the shop for them.',
  },
  {
    name: 'Register and pass KYC in Seller Center',
    text: 'Sign up in TikTok Shop Seller Center with your business-registration documents, phone, email, and bank account, then complete KYC before listing. New shops currently get 0% transaction fee for their first 60 days — a real window to build reviews and content before fees bite.',
  },
  {
    name: 'Register regulated products first',
    text: 'The same product rules apply as everywhere in Vietnam: cosmetics need a DAV notification, food and supplements need VFA declaration/registration, and labels must be in Vietnamese. TikTok Shop verifies documents and delists non-compliant listings — cosmetics and supplements are the most-checked categories because they dominate the platform.',
  },
  {
    name: 'Build for video, not search',
    text: 'TikTok Shop is discovery-driven: products surface in the For You feed and livestreams before buyers search. Prioritize SKUs that demonstrate well on video — fashion, beauty, FMCG novelties, low-to-mid-ticket impulse buys — with clear images, keyword-rich titles, accurate category (it sets your commission), and correct weight/dimensions.',
  },
  {
    name: 'Wire up creators and livestreams',
    text: 'Set an affiliate commission so creators promote your products, and run (or sponsor) livestreams — creator-led livestreams during campaigns drive a disproportionate share of Vietnamese sales. Factor the affiliate commission you offer (often 10–30%) into your pricing; it stacks on top of platform fees.',
  },
  {
    name: 'Price for a 30%+ take rate, then launch and iterate',
    text: 'Between commission, the 6% transaction fee, optional Voucher Extra, affiliate commissions, ads, and shipping, TikTok Shop can absorb well over 30% of revenue. Price accordingly, fulfill within the handover window, respond within 24 hours, and use Dynamic Commission (fee relief for sellers who invest in Shop Ads) to offset costs.',
  },
];

const feeRows = [
  { fee: 'Transaction fee', rate: '6%', note: 'Raised from 5% on 9 May 2026. New sellers: 0% for first 60 days. GMV Max-eligible: 5%' },
  { fee: 'Commission — standard seller default', rate: '14%', note: 'For level-3 categories not separately listed' },
  { fee: 'Commission — Mall seller default', rate: '16%', note: 'Raised from 15.5% on 3 Aug 2026' },
  { fee: 'Commission — Health, beauty & personal care', rate: 'up to 19.8%', note: 'Highest tier; Mall, from 3 Aug 2026' },
  { fee: 'Commission — Fashion (Mall)', rate: '~16–17.1%', note: 'Shoes, women\'s fashion, underwear' },
  { fee: 'Commission — Home & living', rate: 'up to 18.1%', note: '' },
  { fee: 'Commission — Groceries (standard)', rate: '~9–13%', note: 'Among the lower tiers' },
  { fee: 'Voucher Extra (VXP, optional)', rate: '4%', note: 'Per product, capped 50,000₫; raised from 3%' },
  { fee: 'Affiliate commission (you set)', rate: '~10–30%', note: 'Paid to creators; central to the channel, not optional' },
  { fee: 'Decree 117 tax withheld per order (goods)', rate: '1% VAT + 0.5% PIT', note: 'Resident sellers; 1% PIT for non-residents. Platform remits it' },
];

const faqs = [
  {
    question: "Can foreigners sell on TikTok Shop Vietnam?",
    answer: "Not directly the way you can on Shopee. TikTok Shop Vietnam requires a Vietnamese business registration — a household business (hộ kinh doanh) or a registered company — plus a Vietnamese bank account, phone, and KYC. There is no simple ship-from-abroad cross-border seller account. Foreign brands almost always operate through a Vietnam-registered entity, a local partner, or an authorized agency that runs the TikTok Shop on their behalf."
  },
  {
    question: "How much are TikTok Shop Vietnam fees in 2026?",
    answer: "TikTok Shop raised fees twice in 2026. From 9 May the transaction fee went from 5% to 6% and Voucher Extra from 3% to 4%. Category commissions rose again from 3 August: the standard-seller default is 14% and the Mall default is 16%, with health, beauty and personal care reaching up to 19.8%, fashion around 16–17.1%, and home & living up to 18.1%. Local reporting shows total basic fees (commission + transaction + processing) can exceed 25% of order value — up to ~28.8% for the highest-commission categories — before affiliate commissions, ads, vouchers, and shipping. New shops get 0% transaction fee for 60 days."
  },
  {
    question: "How important is livestream on TikTok Shop Vietnam?",
    answer: "It's the core growth engine. Livestream commerce — both your own streams and creator/affiliate livestreams during campaigns — drives a disproportionate share of TikTok Shop sales in Vietnam, far more than static listings. Budget for creator affiliate commissions (often 10–30% of order value) and livestream production; on TikTok Shop these are central costs, not optional extras."
  },
  {
    question: "What taxes apply when selling on TikTok Shop Vietnam?",
    answer: "Under Decree 117/2025/NĐ-CP (effective 1 July 2025), TikTok Shop withholds and remits tax per order for household/individual sellers: for goods, 1% VAT plus 0.5% personal income tax for residents (1% for non-residents). VAT on the platform's own service fees is temporarily reduced (8%) through 31 December 2026. See our regulation tracker for the underlying instruments."
  },
  {
    question: "What sells best on TikTok Shop Vietnam?",
    answer: "Categories that demonstrate well on video over-index: fashion and accessories, beauty and personal care, FMCG and novelty products, and low-to-mid-ticket impulse buys. The catch in 2026 is that beauty and health — the best-performing video categories — now carry the highest commissions (up to 19.8%), so unit economics matter more than ever. High-consideration products that need comparison shopping usually convert better on Shopee."
  },
  {
    question: "TikTok Shop vs Shopee — which should I prioritize?",
    answer: "Use Shopee for mass, search-led reach and price-sensitive demand; use TikTok Shop for content-led, impulse demand in video-friendly, higher-margin categories. Given TikTok Shop's 2026 commission hikes, many sellers now run both — Shopee for breadth and launches, TikTok Shop for niche, high-margin items and direct audience engagement through livestreams. Model both with our channel selector before committing."
  }
];

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Sell on TikTok Shop in Vietnam",
  "description": description,
  "step": steps.map((s, i) => ({ "@type": "HowToStep", "position": i + 1, "name": s.name, "text": s.text }))
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } }))
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonical}
  pageType="Article"
  articleSection="Guide"
  publishedDate="2026-05-30"
  lastUpdated={updated}
  structuredData={[howToSchema, faqSchema]}
  mainClass="container"
>
  <article class="guide-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides/">Guides</a>
      <span aria-hidden="true">/</span>
      <span>Sell on TikTok Shop Vietnam</span>
    </nav>

    <header class="guide-header">
      <h1>{title}</h1>
      <p class="guide-lead">
        TikTok Shop is Vietnam's fastest-growing e-commerce channel —
        <a href="/data/vietnam-ecommerce-platform-shares/">~41% of 2025 marketplace GMV</a>, up from
        ~29% a year earlier — built on livestream and short-video commerce rather than search. It's also
        raised fees twice in 2026, with some categories now near 20% commission. This guide covers how
        selling on TikTok Shop Vietnam actually works in 2026: the real fee stack, livestream and
        affiliate economics, whether foreigners can sell, product registration, and a worked net-payout
        example. Figures are as of {updated}; confirm current terms in TikTok Shop Seller Center.
      </p>
      <p class="guide-meta">Last updated {updated} · Sourced from TikTok Shop Academy, Công Thương, Lao Động, and Vietnam tax/customs regulations (see <a href="#sources">sources</a>)</p>
    </header>

    <aside class="keyfacts" aria-label="Key numbers">
      <h2 class="keyfacts__title">TikTok Shop Vietnam at a glance (2026)</h2>
      <ul class="keyfacts__grid">
        <li><strong>6%</strong> transaction fee (up from 5%)</li>
        <li><strong>14–19.8%</strong> category commission</li>
        <li><strong>&gt;25–28.8%</strong> total basic fees before ads/affiliate</li>
        <li><strong>10–30%</strong> typical affiliate commission to creators</li>
        <li><strong>0%</strong> transaction fee for first 60 days (new shops)</li>
        <li><strong>~41%</strong> of 2025 marketplace GMV</li>
      </ul>
    </aside>

    <section>
      <h2>Step-by-step</h2>
      <ol class="step-list">
        {steps.map((step, i) => (
          <li class="step-item">
            <div class="step-num">{i + 1}</div>
            <div class="step-body">
              <h3>{step.name}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2 id="fees">What it really costs: TikTok Shop's 2026 fee stack</h2>
      <p>
        TikTok Shop shifted from land-grab to monetization in 2026, raising fees twice. On 9 May the
        transaction fee rose from 5% to <strong>6%</strong> and Voucher Extra from 3% to 4%. On 3 August
        category commissions rose again for Mall sellers, pushing health, beauty and personal care to as
        much as <strong>19.8%</strong>. Local reporting (Lao Động) put total basic fees above
        <strong>25%</strong> of order value — up to ~28.8% for the top-commission categories — before you
        add the affiliate commissions, ads, and livestream production the channel effectively requires.
      </p>
      <div class="fee-table-wrap">
        <table class="fee-table">
          <thead><tr><th>Fee</th><th>Rate</th><th>Notes</th></tr></thead>
          <tbody>
            {feeRows.map(r => (
              <tr>
                <th scope="row">{r.fee}</th>
                <td class="num">{r.rate}</td>
                <td>{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">Commissions are category- and seller-type-specific (Mall vs standard) and VAT-inclusive. Verify your exact level-3 category rate in Seller Center; TikTok Shop changes these frequently.</p>

      <h3>Worked example: net payout on a 100,000₫ beauty order</h3>
      <p>Mall seller, resident, top-commission category, before ads/affiliate:</p>
      <ul class="worked">
        <li>Commission (19.8%): <strong>−19,800₫</strong></li>
        <li>Transaction + processing (~6%): <strong>−6,000₫</strong></li>
        <li>Decree 117 tax withheld (1% VAT + 0.5% PIT): <strong>−1,500₫</strong></li>
        <li>Net before affiliate/ads: <strong>≈72,700₫ (~73%)</strong> — and a 20% creator affiliate commission would take it below 55%</li>
      </ul>
      <p>
        Because affiliate and ad spend are core to TikTok Shop (not optional), your real take-home is
        often meaningfully lower than on Shopee for the same category. Model your category, seller type,
        and creator commission across all three platforms with our
        <a href="/tools/channel-selector/">channel selector (net-payout calculator)</a>.
      </p>
    </section>

    <section>
      <h2>Selling as a foreign brand</h2>
      <p>
        TikTok Shop Vietnam is harder to enter from abroad than Shopee. There is no simple ship-from-abroad
        cross-border account — you generally need a Vietnamese business registration (household business or
        company). In practice, foreign brands use one of three routes:
      </p>
      <ul class="route-list">
        <li><strong>Vietnam entity</strong> — register a company (or work through a household business) to open a first-party TikTok Shop. Most control, most setup.</li>
        <li><strong>Local partner / distributor</strong> — an authorized Vietnamese partner holds the shop and product registrations; you supply product and brand.</li>
        <li><strong>Agency-operated shop</strong> — a TikTok Shop enablement agency runs the store, livestreams, and creator network on your behalf.</li>
      </ul>
      <p>
        Whichever route, price in Vietnam's tax and import reality: the Decree 117 per-order withholding,
        and — if you import stock — duty (0–30% by HS code) plus 10% VAT, since the de-minimis exemption
        was removed on 18 February 2025 (model it with the
        <a href="/tools/landed-cost-calculator/">landed-cost calculator</a>). From 1 July 2026 the new
        E-Commerce Law also tightens obligations on foreign brands. All of this is tracked with sources on
        our <a href="/data/vietnam-regulation-tracker/">Vietnam regulation tracker</a>; see also the full
        <a href="/sell-into-vietnam/">Sell into Vietnam playbook</a>.
      </p>
    </section>

    <section>
      <h2>Product registration &amp; compliance</h2>
      <p>
        Beauty, health, and supplements dominate TikTok Shop — and they're exactly the categories Vietnam
        regulates most tightly and TikTok verifies most aggressively. Register before you list:
      </p>
      <ul class="compliance-list">
        <li><strong>Cosmetics</strong> — DAV notification per formula/SKU (~15–30 business days). Keep the notification receipt for platform checks.</li>
        <li><strong>Food &amp; supplements</strong> — VFA declaration/registration (~1 week to 1–3 months).</li>
        <li><strong>Labeling</strong> — Vietnamese, consistent with your registration; mismatches trigger takedowns. Budget ~$500–2,000/SKU plus lab testing.</li>
      </ul>
      <p>This is the same compliance regime as <a href="/guides/how-to-sell-on-shopee-vietnam/">Shopee</a> — the difference is TikTok Shop's verification tends to hit beauty/supplement sellers hardest because that's the bulk of its catalog.</p>
    </section>

    <section>
      <h2>Logistics and fulfillment</h2>
      <p>
        TikTok Shop integrates major carriers — <a href="/compare/ghn-vs-ghtk-vs-jt-express/">GHN, GHTK,
        and J&amp;T Express</a> — plus Ninja Van and its own fulfillment options. Same-day and next-day
        delivery are standard in HCMC and Hanoi; tier-2/3 cities typically see 2–4 days. Accurate weight
        and dimensions drive shipping fees and carrier eligibility. Fast dispatch matters even more here
        than on Shopee because impulse buyers from livestreams expect quick delivery.
      </p>
    </section>

    <section>
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer-container">
              <p class="faq-answer">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="sources">
      <h2>Sources</h2>
      <ul class="source-list">
        <li>TikTok Shop Academy — official seller fee schedules (seller-vn.tiktok.com)</li>
        <li>Báo Công Thương — "Từ 9/5, TikTok Shop tiếp tục tăng biểu phí" (3 May 2026)</li>
        <li>Lao Động — "TikTok Shop tăng phí từ hôm nay, có ngành hàng chịu phí gần 20%" (3 Aug 2026)</li>
        <li>VietSmart — Q2 2026 commission analysis; Vietnam News — MoIT fee-transparency statement (25 May 2026)</li>
        <li>Decree 117/2025/NĐ-CP and Decision 01/2025/QĐ-TTg — see our <a href="/data/vietnam-regulation-tracker/">regulation tracker</a></li>
      </ul>
      <p class="table-note">This guide is a sourced reference, not legal or tax advice. Fees change frequently — confirm current terms in TikTok Shop Seller Center and with a qualified Vietnamese advisor.</p>
    </section>

    <section>
      <h2>Related references</h2>
      <ul class="related-list">
        <li><a href="/tools/channel-selector/">Channel selector</a> — model net payout across Shopee, TikTok Shop &amp; Lazada</li>
        <li><a href="/guides/how-to-sell-on-shopee-vietnam/">How to sell on Shopee Vietnam</a> · <a href="/guides/how-to-sell-on-lazada-vietnam/">How to sell on Lazada Vietnam</a></li>
        <li><a href="/compare/tiktok-shop-vs-shopee/">TikTok Shop vs Shopee</a> · <a href="/data/vietnam-regulation-tracker/">Vietnam regulation tracker</a></li>
        <li><a href="/sell-into-vietnam/">Sell into Vietnam playbook</a> · <a href="/stats/vietnam-ecommerce-2026/">E-commerce Statistics 2026</a></li>
      </ul>
    </section>

    <p class="guide-footer">
      <a href="/guides/">← All guides</a> · <a href="/sources/">Data sources</a>
    </p>
  </article>
</BaseLayout>

<style>
  .guide-page { max-width: var(--reading-width); }
  .breadcrumb { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-6); }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); text-decoration: underline; }
  .guide-header { margin-bottom: var(--space-6); }
  .guide-header h1 { border: none; margin-bottom: var(--space-3); }
  .guide-lead { font-size: var(--text-lg); line-height: 1.6; color: var(--color-text); }
  .guide-lead a { color: var(--color-accent); }
  .guide-meta { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }
  .guide-meta a { color: var(--color-accent); }
  .keyfacts { background: var(--color-bg-subtle); border: 1px solid var(--color-border-light); border-left: 3px solid var(--color-accent); border-radius: 2px; padding: var(--space-5) var(--space-6); margin-bottom: var(--space-8); }
  .keyfacts__title { margin: 0 0 var(--space-3); font-size: var(--text-base); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); border: none; }
  .keyfacts__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-3) var(--space-5); }
  .keyfacts__grid li { line-height: 1.4; font-size: var(--text-sm); color: var(--color-text-muted); }
  .keyfacts__grid strong { display: block; font-size: var(--text-xl); color: var(--color-accent); font-variant-numeric: tabular-nums; }
  section { margin-bottom: var(--space-10); }
  .step-list { list-style: none; padding: 0; margin: var(--space-4) 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .step-item { display: flex; gap: var(--space-4); align-items: flex-start; }
  .step-num { flex: 0 0 auto; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: var(--text-sm); }
  .step-body h3 { margin: 0 0 var(--space-2); font-size: var(--text-lg); }
  .step-body p { margin: 0; line-height: 1.6; color: var(--color-text); }
  .fee-table-wrap { overflow-x: auto; margin: var(--space-4) 0; }
  .fee-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .fee-table th, .fee-table td { border: 1px solid var(--color-border-light); padding: var(--space-2) var(--space-3); text-align: left; vertical-align: top; }
  .fee-table thead th { background: var(--color-bg-subtle); font-weight: 600; }
  .fee-table tbody th { background: var(--color-bg-subtle); font-weight: 600; }
  .fee-table .num { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--color-accent); white-space: nowrap; }
  .table-note { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.55; }
  .worked { margin: var(--space-3) 0; line-height: 1.7; }
  .worked strong { font-variant-numeric: tabular-nums; }
  .route-list, .compliance-list { line-height: 1.65; }
  .route-list li, .compliance-list li { margin-bottom: var(--space-3); }
  section p a, .route-list a, .compliance-list a, .source-list a { color: var(--color-accent); }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .faq-item { border: 1px solid var(--color-border); border-radius: 2px; background: var(--color-bg-subtle); }
  .faq-question { cursor: pointer; padding: 1rem 1.25rem; font-weight: 600; color: var(--color-text); list-style: none; }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after { content: '+'; float: right; color: var(--color-text-muted); }
  .faq-item[open] .faq-question::after { content: '−'; }
  .faq-answer-container { padding: 0 1.25rem 1rem; border-top: 1px solid var(--color-border-light); }
  .faq-answer { margin: 1rem 0 0; color: var(--color-text); line-height: 1.65; }
  .source-list { line-height: 1.6; }
  .source-list li { margin-bottom: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }
  .related-list { list-style: none; padding: 0; margin: var(--space-4) 0; }
  .related-list li { margin-bottom: var(--space-2); line-height: 1.55; }
  .related-list a { color: var(--color-accent); text-decoration: none; }
  .related-list a:hover { text-decoration: underline; }
  .guide-footer { margin-top: var(--space-10); font-size: var(--text-sm); color: var(--color-text-muted); }
  .guide-footer a { color: var(--color-text-muted); }
  .guide-footer a:hover { color: var(--color-accent); }
</style>
