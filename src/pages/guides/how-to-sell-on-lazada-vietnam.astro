---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = "How to Sell on Lazada in Vietnam (2026) — Fees, LazMall & Cross-Border";
const description = "A sourced guide to selling on Lazada Vietnam in 2026: the low commission (3–4% standard, 5–12% LazMall), payment fees, who can sell cross-border via LazGlobal, product registration, and where Lazada fits now that it's a niche ~2% GMV channel.";
const canonical = "https://vnmarketinsights.com/guides/how-to-sell-on-lazada-vietnam/";
const updated = "2026-08-12";

const steps = [
  {
    name: 'Decide whether Lazada is worth it for you',
    text: 'Lazada is now the smallest of Vietnam\'s big marketplaces — roughly 2% of 2025 GMV — after Shopee and TikTok Shop pulled away. Its advantage is cost: commissions are far lower than Shopee or TikTok Shop. Treat it as a secondary, brand-trust channel (especially via LazMall) rather than your primary volume driver.',
  },
  {
    name: 'Choose standard shop vs LazMall',
    text: 'A standard Marketplace shop is open to any seller and carries a low fixed fee (3–4%). LazMall is the official brand-store format with a trust badge and priority visibility, but it requires you to be a brand owner or authorized distributor and to meet performance thresholds — and its commission is higher (5–12%).',
  },
  {
    name: 'Register and verify',
    text: 'Sign up in Lazada Seller Center with a Vietnamese business registration (or eligible individual documents), phone, and bank account, then complete verification. New standard shops typically get the fixed fee waived for their first 90 days — a longer grace period than Shopee\'s 30 days.',
  },
  {
    name: 'Register regulated products first',
    text: 'As on every Vietnamese platform, cosmetics need a DAV notification, food and supplements need VFA declaration/registration, and labels must be in Vietnamese. Lazada requests documents during verification and delists non-compliant listings.',
  },
  {
    name: 'List, price for the (lower) fee stack, and connect logistics',
    text: 'Create listings with clear images, accurate categories, and correct weight/dimensions. Price for a ~10–15% platform take once commission, the ~4% payment fee, and optional Freeship Max are included — still materially cheaper than Shopee/TikTok. Enable Lazada Logistics (LEX) plus GHN and Ninja Van for coverage.',
  },
  {
    name: 'Launch and lean on brand trust',
    text: 'Lazada\'s audience skews toward buyers who value authenticity and official-store assurance. Use LazMall status, genuine reviews, and campaign participation (11.11, 12.12) to convert. Keep cancellation, on-time delivery, and chat-response metrics healthy — LazMall penalties for missing them are steep.',
  },
];

const feeRows = [
  { fee: 'Fixed fee (commission) — standard shop', rate: '~3.3–4.4%', note: 'VAT-incl; ~3–4% ex-VAT, by category. Now applies to all sellers, not just LazMall' },
  { fee: 'Fixed fee — LazMall', rate: '5–12%', note: 'VAT-incl; electronics ~5–6%, fashion/health/beauty ~8–12%' },
  { fee: 'Payment fee', rate: '~3.99–4.02%', note: 'VAT-incl; on total order value (product after shop voucher + buyer-paid shipping)' },
  { fee: 'New standard shop', rate: '0% fixed fee', note: 'Typically first 90 days' },
  { fee: 'Cross-border small-parcel commission', rate: '+1.77%', note: 'Added from 29 Jan 2026 (VAT-incl) for cross-border direct-mail goods' },
  { fee: 'Freeship Max (optional)', rate: 'varies', note: 'Seller-funded free-shipping program' },
  { fee: 'Decree 117 tax withheld per order (goods)', rate: '1% VAT + 0.5% PIT', note: 'Resident sellers; 1% PIT for non-residents. Platform remits it' },
];

const faqs = [
  {
    question: "How much are Lazada Vietnam fees in 2026?",
    answer: "Lazada is the cheapest of Vietnam's big marketplaces. Standard shops pay a fixed fee (commission) of about 3–4% before VAT (roughly 3.3–4.4% including VAT), by category, plus a payment fee of about 3.99–4.02% (VAT-included). LazMall shops pay a higher fixed fee of 5–12% depending on category (electronics ~5–6%, fashion/health/beauty ~8–12%). New standard shops usually get the fixed fee waived for 90 days. Cross-border direct-mail goods had a 1.77% commission added from 29 January 2026."
  },
  {
    question: "Can foreigners sell on Lazada Vietnam?",
    answer: "Yes, but cross-border access is narrow. Lazada's cross-border program (LazGlobal) lets you sell into Vietnam without a local company, but it currently only accepts international sellers from Japan, South Korea, and mainland China (including Hong Kong); business verification takes 1–2 weeks. Sellers from other countries generally need a Vietnam-registered entity or an authorized local distributor — which is also required for LazMall."
  },
  {
    question: "Is Lazada still worth selling on in Vietnam?",
    answer: "As a primary channel, rarely — Lazada is down to roughly 2% of marketplace GMV after Shopee (~56%) and TikTok Shop (~41%) took the market. As a secondary channel it can still make sense: its commissions are far lower than Shopee or TikTok Shop, and its audience skews toward authenticity-focused buyers, which suits official LazMall brand stores. Many brands run it as a low-cost reach extension rather than their main store."
  },
  {
    question: "What's the difference between a standard Lazada shop and LazMall?",
    answer: "A standard Marketplace shop is open to anyone and has the lowest fees. LazMall is the official brand-store format: it requires you to be a brand owner or authorized distributor and to meet performance criteria (typically ~6 months of history, 30+ orders/month, seller rating above 70%, cancellation below 2%, on-time delivery above 90%, chat response above 85%, and return rate below 1%). LazMall carries a higher commission (5–12%) but the Mall badge and priority visibility convert better."
  },
  {
    question: "What taxes apply when selling on Lazada Vietnam?",
    answer: "Under Decree 117/2025/NĐ-CP (effective 1 July 2025), Lazada withholds and remits tax per order for household/individual sellers: for goods, 1% VAT plus 0.5% personal income tax for residents (1% for non-residents). Cross-border parcels also carry import duty (0–30% by HS code) plus 10% VAT — the low-value de-minimis exemption was removed on 18 February 2025. See our regulation tracker for details."
  }
];

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Sell on Lazada in Vietnam",
  "description": description,
  "step": steps.map((s, i) => ({ "@type": "HowToStep", "position": i + 1, "name": s.name, "text": s.text }))
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } }))
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonical}
  pageType="Article"
  articleSection="Guide"
  publishedDate={updated}
  lastUpdated={updated}
  structuredData={[howToSchema, faqSchema]}
  mainClass="container"
>
  <article class="guide-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/guides/">Guides</a>
      <span aria-hidden="true">/</span>
      <span>Sell on Lazada Vietnam</span>
    </nav>

    <header class="guide-header">
      <h1>{title}</h1>
      <p class="guide-lead">
        Lazada is now Vietnam's smallest major marketplace —
        <a href="/data/vietnam-ecommerce-platform-shares/">around 2% of 2025 GMV</a> — but it's also the
        cheapest to sell on, and its official-store (LazMall) format still carries real brand trust. This
        guide covers how selling on Lazada Vietnam works in 2026: the low fee stack, standard shop vs
        LazMall, who can sell cross-border via LazGlobal, product registration, and where Lazada actually
        fits in a Vietnam channel mix. Figures are as of {updated}; confirm current terms in Lazada Seller
        Center.
      </p>
      <p class="guide-meta">Last updated {updated} · Sourced from Lazada seller fee schedules, MISA eShop, BigSeller, and Vietnam tax/customs regulations (see <a href="#sources">sources</a>)</p>
    </header>

    <aside class="keyfacts" aria-label="Key numbers">
      <h2 class="keyfacts__title">Lazada Vietnam at a glance (2026)</h2>
      <ul class="keyfacts__grid">
        <li><strong>3–4%</strong> standard commission (lowest of the big three)</li>
        <li><strong>5–12%</strong> LazMall commission</li>
        <li><strong>~4%</strong> payment fee</li>
        <li><strong>90 days</strong> fixed-fee waiver (new shops)</li>
        <li><strong>JP/KR/CN only</strong> for LazGlobal cross-border</li>
        <li><strong>~2%</strong> of 2025 marketplace GMV</li>
      </ul>
    </aside>

    <section>
      <h2>Step-by-step</h2>
      <ol class="step-list">
        {steps.map((step, i) => (
          <li class="step-item">
            <div class="step-num">{i + 1}</div>
            <div class="step-body">
              <h3>{step.name}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2 id="fees">Lazada's 2026 fee stack — the cheapest of the big three</h2>
      <p>
        Where Shopee and TikTok Shop pushed total take rates toward 25–45% in 2026, Lazada stayed low. A
        standard shop pays roughly <strong>3–4%</strong> commission (before VAT) plus a
        <strong>~4%</strong> payment fee. LazMall costs more (5–12% commission) in exchange for the trust
        badge and visibility. The trade-off is reach: Lazada's audience is a fraction of Shopee's or
        TikTok Shop's, so lower fees don't automatically mean more profit — they mean cheaper access to a
        smaller pool.
      </p>
      <div class="fee-table-wrap">
        <table class="fee-table">
          <thead><tr><th>Fee</th><th>Rate</th><th>Notes</th></tr></thead>
          <tbody>
            {feeRows.map(r => (
              <tr>
                <th scope="row">{r.fee}</th>
                <td class="num">{r.rate}</td>
                <td>{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">Fixed-fee percentages are category-specific. Verify your exact rate and any active campaign service fees in Lazada Seller Center.</p>

      <h3>Worked example: net payout on a 200,000₫ fashion order</h3>
      <p>Standard shop, resident, before optional programs:</p>
      <ul class="worked">
        <li>Commission (~4.4% VAT-incl): <strong>−8,800₫</strong></li>
        <li>Payment fee (~4%): <strong>−8,000₫</strong></li>
        <li>Decree 117 tax withheld (1% VAT + 0.5% PIT): <strong>−3,000₫</strong></li>
        <li>Net before shipping/ads: <strong>≈180,200₫ (~90%)</strong></li>
      </ul>
      <p>
        That ~90% take-home compares to roughly 68–74% on Shopee and often below 55% on TikTok Shop for
        the same order once affiliate costs are included. Model the full comparison for your category with
        our <a href="/tools/channel-selector/">channel selector</a>.
      </p>
    </section>

    <section>
      <h2>Selling as a foreign brand</h2>
      <p>Two routes, depending on where you're based:</p>
      <ul class="route-list">
        <li><strong>LazGlobal cross-border</strong> — sell into Vietnam without a local entity, but only if you're a seller in <strong>Japan, South Korea, or mainland China (incl. Hong Kong)</strong>. Business verification takes 1–2 weeks, and a 1.77% cross-border commission was added on 29 Jan 2026.</li>
        <li><strong>Vietnam entity or authorized distributor</strong> — required for sellers from other countries and for LazMall. A local distributor can also hold your product registrations.</li>
      </ul>
      <p>
        Either way, factor in the Decree 117 per-order withholding and, if you import stock, duty (0–30% by
        HS code) plus 10% VAT after the de-minimis exemption's removal on 18 February 2025 — model it with
        the <a href="/tools/landed-cost-calculator/">landed-cost calculator</a>. The 1 July 2026
        E-Commerce Law and other current rules are tracked on our
        <a href="/data/vietnam-regulation-tracker/">Vietnam regulation tracker</a>; see also the
        <a href="/sell-into-vietnam/">Sell into Vietnam playbook</a>.
      </p>
    </section>

    <section>
      <h2>Product registration &amp; compliance</h2>
      <p>The compliance regime is identical across Vietnamese platforms: register regulated products before listing.</p>
      <ul class="compliance-list">
        <li><strong>Cosmetics</strong> — DAV notification per formula/SKU (~15–30 business days).</li>
        <li><strong>Food &amp; supplements</strong> — VFA declaration/registration (~1 week to 1–3 months).</li>
        <li><strong>Labeling</strong> — Vietnamese, consistent with registration; ~$500–2,000/SKU plus lab testing.</li>
      </ul>
      <p>For the full breakdown, see the compliance section of our <a href="/guides/how-to-sell-on-shopee-vietnam/">Shopee guide</a> — the rules are the same regardless of platform.</p>
    </section>

    <section>
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer-container">
              <p class="faq-answer">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section id="sources">
      <h2>Sources</h2>
      <ul class="source-list">
        <li>Lazada Seller Center fee schedules; MISA eShop and BigSeller 2026 Lazada fee breakdowns</li>
        <li>Lazada VN commission adjustment notice, effective 29 Jan 2026 (cross-border +1.77%)</li>
        <li>Platform GMV shares — our <a href="/data/vietnam-ecommerce-platform-shares/">first-party dataset</a></li>
        <li>Decree 117/2025/NĐ-CP and Decision 01/2025/QĐ-TTg — see our <a href="/data/vietnam-regulation-tracker/">regulation tracker</a></li>
      </ul>
      <p class="table-note">This guide is a sourced reference, not legal or tax advice. Fees change — confirm current terms in Lazada Seller Center and with a qualified Vietnamese advisor.</p>
    </section>

    <section>
      <h2>Related references</h2>
      <ul class="related-list">
        <li><a href="/tools/channel-selector/">Channel selector</a> — model net payout across Shopee, TikTok Shop &amp; Lazada</li>
        <li><a href="/guides/how-to-sell-on-shopee-vietnam/">How to sell on Shopee Vietnam</a> · <a href="/guides/how-to-sell-on-tiktok-shop-vietnam/">How to sell on TikTok Shop Vietnam</a></li>
        <li><a href="/compare/lazada-vs-shopee/">Lazada vs Shopee</a> · <a href="/data/vietnam-regulation-tracker/">Vietnam regulation tracker</a></li>
        <li><a href="/sell-into-vietnam/">Sell into Vietnam playbook</a> · <a href="/stats/vietnam-ecommerce-2026/">E-commerce Statistics 2026</a></li>
      </ul>
    </section>

    <p class="guide-footer">
      <a href="/guides/">← All guides</a> · <a href="/sources/">Data sources</a>
    </p>
  </article>
</BaseLayout>

<style>
  .guide-page { max-width: var(--reading-width); }
  .breadcrumb { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-6); }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-accent); text-decoration: underline; }
  .guide-header { margin-bottom: var(--space-6); }
  .guide-header h1 { border: none; margin-bottom: var(--space-3); }
  .guide-lead { font-size: var(--text-lg); line-height: 1.6; color: var(--color-text); }
  .guide-lead a { color: var(--color-accent); }
  .guide-meta { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }
  .guide-meta a { color: var(--color-accent); }
  .keyfacts { background: var(--color-bg-subtle); border: 1px solid var(--color-border-light); border-left: 3px solid var(--color-accent); border-radius: 2px; padding: var(--space-5) var(--space-6); margin-bottom: var(--space-8); }
  .keyfacts__title { margin: 0 0 var(--space-3); font-size: var(--text-base); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); border: none; }
  .keyfacts__grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-3) var(--space-5); }
  .keyfacts__grid li { line-height: 1.4; font-size: var(--text-sm); color: var(--color-text-muted); }
  .keyfacts__grid strong { display: block; font-size: var(--text-xl); color: var(--color-accent); font-variant-numeric: tabular-nums; }
  section { margin-bottom: var(--space-10); }
  .step-list { list-style: none; padding: 0; margin: var(--space-4) 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .step-item { display: flex; gap: var(--space-4); align-items: flex-start; }
  .step-num { flex: 0 0 auto; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-accent); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: var(--text-sm); }
  .step-body h3 { margin: 0 0 var(--space-2); font-size: var(--text-lg); }
  .step-body p { margin: 0; line-height: 1.6; color: var(--color-text); }
  .fee-table-wrap { overflow-x: auto; margin: var(--space-4) 0; }
  .fee-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .fee-table th, .fee-table td { border: 1px solid var(--color-border-light); padding: var(--space-2) var(--space-3); text-align: left; vertical-align: top; }
  .fee-table thead th { background: var(--color-bg-subtle); font-weight: 600; }
  .fee-table tbody th { background: var(--color-bg-subtle); font-weight: 600; }
  .fee-table .num { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--color-accent); white-space: nowrap; }
  .table-note { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.55; }
  .worked { margin: var(--space-3) 0; line-height: 1.7; }
  .worked strong { font-variant-numeric: tabular-nums; }
  .route-list, .compliance-list { line-height: 1.65; }
  .route-list li, .compliance-list li { margin-bottom: var(--space-3); }
  section p a, .route-list a, .compliance-list a, .source-list a { color: var(--color-accent); }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .faq-item { border: 1px solid var(--color-border); border-radius: 2px; background: var(--color-bg-subtle); }
  .faq-question { cursor: pointer; padding: 1rem 1.25rem; font-weight: 600; color: var(--color-text); list-style: none; }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after { content: '+'; float: right; color: var(--color-text-muted); }
  .faq-item[open] .faq-question::after { content: '−'; }
  .faq-answer-container { padding: 0 1.25rem 1rem; border-top: 1px solid var(--color-border-light); }
  .faq-answer { margin: 1rem 0 0; color: var(--color-text); line-height: 1.65; }
  .source-list { line-height: 1.6; }
  .source-list li { margin-bottom: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }
  .related-list { list-style: none; padding: 0; margin: var(--space-4) 0; }
  .related-list li { margin-bottom: var(--space-2); line-height: 1.55; }
  .related-list a { color: var(--color-accent); text-decoration: none; }
  .related-list a:hover { text-decoration: underline; }
  .guide-footer { margin-top: var(--space-10); font-size: var(--text-sm); color: var(--color-text-muted); }
  .guide-footer a { color: var(--color-text-muted); }
  .guide-footer a:hover { color: var(--color-accent); }
</style>
